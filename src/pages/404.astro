---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found"><section class="mx-auto max-w-3xl px-5 py-24"><p class="font-mono text-xs uppercase tracking-wider text-signal">404</p><h1 class="mt-3 text-5xl font-semibold text-ink">No signal here.</h1><p class="mt-5 text-lg text-slate">The page may have moved, or the address is incorrect.</p><a class="mt-8 inline-block bg-signal px-5 py-3 font-semibold text-[#071019] no-underline" href="/">Return home</a></section></BaseLayout>
