---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { isProductionPost, slugify } from '../lib/site';
const posts = (await getCollection('blog', isProductionPost)).sort((a,b) => b.data.published.valueOf() - a.data.published.valueOf());
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---
<BaseLayout><section class="relative overflow-hidden border-b border-line"><div class="absolute inset-0 opacity-30 [background-image:linear-gradient(#263342_1px,transparent_1px),linear-gradient(90deg,#263342_1px,transparent_1px)] [background-size:36px_36px]"></div><div class="relative mx-auto max-w-6xl px-5 py-20 sm:py-28"><p class="font-mono text-xs uppercase tracking-[.2em] text-signal">Research log · defensive engineering</p><h1 class="mt-6 max-w-4xl text-5xl font-semibold tracking-tight text-ink sm:text-7xl">Security work that holds up under scrutiny.</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-slate">Signal Surface is a personal research notebook for practical detection, resilient infrastructure, and the mechanics behind real-world security controls.</p><div class="mt-9 flex flex-wrap gap-4"><a class="bg-signal px-5 py-3 font-semibold text-[#071019] no-underline" href="/blog/">Explore research</a><a class="border border-line px-5 py-3 font-semibold no-underline" href="/security/">Disclosure policy</a></div></div></section><section class="mx-auto max-w-6xl px-5 py-16"><div class="flex items-end justify-between gap-4"><div><p class="font-mono text-xs uppercase tracking-wider text-signal">Latest analysis</p><h2 class="mt-2 text-3xl font-semibold text-ink">Recent research</h2></div><a href="/blog/">All articles →</a></div><div class="mt-8 grid gap-5 md:grid-cols-2">{posts.slice(0, 4).map((post) => <PostCard post={post} />)}</div></section><section class="border-y border-line bg-panel"><div class="mx-auto max-w-6xl px-5 py-14"><p class="font-mono text-xs uppercase tracking-wider text-signal">Topics</p><div class="mt-5 flex flex-wrap gap-3">{tags.map((tag) => <a href={`/tags/${slugify(tag)}/`} class="border border-line px-3 py-2 font-mono text-sm text-slate no-underline hover:border-signal">#{tag}</a>)}</div></div></section></BaseLayout>
