---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import PostTile from '../components/PostTile.astro';
import { isProductionPost } from '../lib/site';
const posts = (await getCollection('blog', isProductionPost)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<BaseLayout>
  <div class="pin-wrap">
    <div class="pin-inner" id="pin-inner">
      <KnowledgeGraph />
    </div>
  </div>

  <section id="recent-research" class="relative mx-auto max-w-6xl px-5 py-20">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-signal">Latest analysis</p>
        <h2 class="mt-2 text-3xl font-semibold text-ink">Recent research</h2>
      </div>
      <a href="/blog/">All articles →</a>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {posts.map((post, i) => <PostTile post={post} index={i} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .pin-wrap { position: relative; height: 135vh; background: #060a0f; }
  .pin-inner { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  @media (max-width: 859px) { .pin-wrap { height: auto; } .pin-inner { position: relative; height: auto; } }
</style>

<script>
  const pinWrap = document.querySelector('.pin-wrap');
  const pinInner = document.querySelector('.pin-inner');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isPinnable = () => window.matchMedia('(min-width: 860px)').matches;

  if (pinWrap instanceof HTMLElement && pinInner instanceof HTMLElement && !reduceMotion) {
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!isPinnable()) { pinInner.style.opacity = ''; pinInner.style.transform = ''; return; }
      const rect = pinWrap.getBoundingClientRect();
      const scrollRange = rect.height - window.innerHeight;
      const progress = scrollRange > 0 ? Math.min(Math.max(-rect.top / scrollRange, 0), 1) : 0;
      const fade = Math.min(progress * 1.08, 1);
      pinInner.style.opacity = String(1 - fade);
      pinInner.style.transform = `scale(${1 - progress * 0.08}) translateY(${progress * -24}px)`;
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }

  const revealTargets = document.querySelectorAll('[data-reveal]');
  if ('IntersectionObserver' in window && revealTargets.length) {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) { entry.target.classList.add('is-visible'); io.unobserve(entry.target); }
      }
    }, { threshold: 0.15 });
    revealTargets.forEach((el) => io.observe(el));
  } else {
    revealTargets.forEach((el) => el.classList.add('is-visible'));
  }
</script>