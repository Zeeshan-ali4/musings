---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { isProductionPost, slugify } from '../lib/site';

const allPosts = await getCollection('blog');
const posts = allPosts.filter(isProductionPost).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();
---
<BaseLayout>
  <section class="home-intro"><div class="mx-auto max-w-6xl px-5 py-16 sm:py-24"><p class="eyebrow">My notes on security engineering</p><div class="mt-8 grid gap-10 lg:grid-cols-[1.25fr_.75fr] lg:items-end"><div><h1 class="max-w-4xl text-5xl font-semibold tracking-tight text-ink sm:text-7xl">Things I’m trying to understand.</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-slate">Mostly notes about detection, infrastructure, and the awkward details that do not fit cleanly in a runbook. Some are worked through; some are still in progress.</p><a class="mt-8 inline-block border-b-2 border-signal pb-1 font-semibold no-underline" href="/blog/">Read the notes →</a></div><aside class="current-note"><p class="eyebrow">On my mind</p><p class="mt-4 text-xl leading-8 text-ink">A place for questions, half-formed ideas, and the threads that are worth returning to.</p><a class="mt-5 inline-block text-sm" href="/now/">What else I’m looking at →</a></aside></div></div></section>
  <section class="mx-auto max-w-6xl px-5 py-16"><div class="flex items-end justify-between gap-4"><div><p class="eyebrow">Recent notes</p><h2 class="mt-2 text-3xl font-semibold text-ink">A few threads worth pulling.</h2></div>{posts.length > 0 && <a href="/blog/">Everything, oldest first →</a>}</div>{posts.length > 0 ? <div class="editorial-stack mt-9">{posts.slice(0, 4).map((post, index) => <div class={index === 0 ? 'featured-note' : ''}><PostCard post={post} /></div>)}</div> : <p class="empty-state mt-9">Published notes will appear here as they are ready.</p>}</section>
  {tags.length > 0 && <section class="topic-trails"><div class="mx-auto max-w-6xl px-5 py-14"><div class="grid gap-8 md:grid-cols-[.7fr_1.3fr]"><div><p class="eyebrow">Follow a thread</p><h2 class="mt-3 text-3xl font-semibold text-ink">There is no right place to start.</h2><p class="mt-4 leading-7 text-slate">These hashtags are collected from every note in the notebook, including work still in draft.</p></div><div class="trail-list">{tags.map((tag, index) => <a href={`/tags/${slugify(tag)}/`} class="trail-link no-underline"><span>{String(index + 1).padStart(2, '0')}</span> #{tag} <b>↗</b></a>)}</div></div></div></section>}
</BaseLayout>
