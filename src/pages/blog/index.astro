---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { isProductionPost } from '../../lib/site';
const posts = (await getCollection('blog', isProductionPost)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<BaseLayout title="Writing"><section class="mx-auto max-w-6xl px-5 py-16"><p class="eyebrow">The archive</p><h1 class="mt-3 text-4xl font-semibold text-ink">Writing and working notes.</h1><p class="mt-4 max-w-2xl leading-7 text-slate">Essays from the workbench: detection, infrastructure, and the awkward details that are easy to skip over.</p>{posts.length > 0 ? <div class="editorial-stack mt-12">{posts.map((post, index) => <div class={index === 0 ? 'featured-note' : ''}><PostCard post={post} /></div>)}</div> : <p class="empty-state mt-12">The archive is quiet for now. New writing will collect here automatically.</p>}</section></BaseLayout>
