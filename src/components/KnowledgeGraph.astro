---
import { getCollection } from 'astro:content';
import PixelIcon from './PixelIcon.astro';
import PixelCharacter from './PixelCharacter.astro';
import { ICONS, MOON, SCROLL_MOUSE } from '../lib/pixel-icons';
import { isProductionPost, slugify } from '../lib/site';

const posts = await getCollection('blog', isProductionPost);
const existingTags = new Set(posts.flatMap((p) => p.data.tags.map((t) => slugify(t))));
const hrefFor = (label: string, fallbackTag?: string) => {
  const slug = fallbackTag ? slugify(fallbackTag) : slugify(label);
  return existingTags.has(slug) ? `/tags/${slug}/` : '/blog/';
};

type Leaf = { label: string; x: number; y: number; tag?: string };
type Hub = { key: keyof typeof ICONS; label: string; x: number; y: number; leaves: Leaf[] };

const hubs: Hub[] = [
  {
    key: 'network', label: 'Network', x: 50, y: 15,
    leaves: [
      { label: 'DNS', x: 50, y: 2, tag: 'dns' },
      { label: 'Protocols', x: 29, y: 8 },
      { label: 'Firewalls', x: 71, y: 8 },
      { label: 'Traffic Analysis', x: 76, y: 16 }
    ]
  },
  {
    key: 'identity', label: 'Identity', x: 18, y: 32,
    leaves: [
      { label: 'Authentication', x: 3, y: 13 },
      { label: 'Kerberos', x: 2, y: 25, tag: 'kerberos' },
      { label: 'Active Directory', x: 4, y: 38, tag: 'active-directory' },
      { label: 'Privileges', x: 15, y: 45 }
    ]
  },
  {
    key: 'cloud', label: 'Cloud', x: 82, y: 32,
    leaves: [
      { label: 'AWS', x: 97, y: 13 },
      { label: 'Azure', x: 98, y: 25 },
      { label: 'IAM', x: 96, y: 38 },
      { label: 'Misconfig', x: 85, y: 45 }
    ]
  },
  {
    key: 'web', label: 'Web', x: 16, y: 65,
    leaves: [
      { label: 'CSP', x: 2, y: 56, tag: 'csp' },
      { label: 'Architecture', x: 1, y: 70 },
      { label: 'XSS', x: 3, y: 83 },
      { label: 'CSRF', x: 12, y: 92 }
    ]
  },
  {
    key: 'malware', label: 'Malware', x: 84, y: 65,
    leaves: [
      { label: 'Persistence', x: 98, y: 56 },
      { label: 'C2', x: 99, y: 70 },
      { label: 'Loaders', x: 97, y: 83 },
      { label: 'Fileless', x: 88, y: 92 }
    ]
  },
  {
    key: 'detection', label: 'Detection', x: 50, y: 43,
    leaves: [
      { label: 'Logs', x: 36, y: 55 },
      { label: 'SIEM', x: 32, y: 64 },
      { label: 'Threat Hunting', x: 62, y: 55 },
      { label: 'Incident Response', x: 66, y: 64 }
    ]
  }
];

const detection = hubs.find((h) => h.key === 'detection')!;
const hubLines = hubs.filter((h) => h.key !== 'detection').map((h) => ({ x1: detection.x, y1: detection.y, x2: h.x, y2: h.y, color: `var(--node-${h.key})` }));
const leafLines = hubs.flatMap((h) => h.leaves.map((l) => ({ x1: h.x, y1: h.y, x2: l.x, y2: l.y, color: `var(--node-${h.key})` })));
---
<div class="graph-hero" id="graph-hero">
  <div class="starfield" aria-hidden="true"></div>
  <span class="moon"><PixelIcon map={MOON} color="#c9d6e3" /></span>

  <p class="eyebrow">Research log &middot; defensive engineering</p>

  <div class="graph-stage" role="navigation" aria-label="Research topics">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="graph-lines" aria-hidden="true">
      {hubLines.map((l) => (
        <>
          <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke={l.color} stroke-width="0.35" stroke-dasharray="1.6 1.4" opacity="0.55" />
          <rect x={(l.x1 + l.x2) / 2 - 0.6} y={(l.y1 + l.y2) / 2 - 0.6} width="1.2" height="1.2" fill={l.color} opacity="0.85" />
        </>
      ))}
      {leafLines.map((l) => (
        <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke={l.color} stroke-width="0.22" stroke-dasharray="1 1.2" opacity="0.4" />
      ))}
    </svg>

    {hubs.map((h) => (
      <a href={hrefFor(h.label, h.key === 'web' ? 'web-security' : h.key)} class="hub" data-hub={h.key} style={`left:${h.x}%; top:${h.y}%; --hub-color: var(--node-${h.key});`}>
        <span class="hub-icon"><PixelIcon map={ICONS[h.key]} color={`var(--node-${h.key})`} /></span>
        <span class="hub-label">{h.label}</span>
      </a>
    ))}

    {hubs.flatMap((h) => h.leaves.map((l) => (
      <a href={hrefFor(l.label, l.tag)} class="leaf" style={`left:${l.x}%; top:${l.y}%; --hub-color: var(--node-${h.key});`}>{l.label}</a>
    )))}
  </div>

  <details class="graph-mobile">
    <summary>Browse research topics</summary>
    <div class="graph-mobile-grid">
      {hubs.map((h) => (
        <div class="mobile-hub" style={`--hub-color: var(--node-${h.key});`}>
          <a href={hrefFor(h.label, h.key === 'web' ? 'web-security' : h.key)} class="mobile-hub-title">
            <span class="hub-icon"><PixelIcon map={ICONS[h.key]} color={`var(--node-${h.key})`} /></span>
            {h.label}
          </a>
          <div class="mobile-leaf-row">
            {h.leaves.map((l) => <a href={hrefFor(l.label, l.tag)} class="mobile-leaf">{l.label}</a>)}
          </div>
        </div>
      ))}
    </div>
  </details>

  <div class="beam" aria-hidden="true"></div>

  <div class="character-wrap">
    <span class="character"><PixelCharacter /></span>
  </div>

  <a href="#recent-research" class="scroll-hint">
    <span class="scroll-icon"><PixelIcon map={SCROLL_MOUSE} color="#7f8fa3" /></span>
    <span>SCROLL</span>
  </a>
</div>

<style>
  .graph-hero {
    --node-identity: #5b8cff; --node-network: #4ee08a; --node-cloud: #b98bff;
    --node-web: #38d9e8; --node-malware: #ff6b7a; --node-detection: #ffc94d;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: calc(100vh - var(--header-h, 64px));
    min-height: 600px;
    overflow: hidden;
    background: #060a0f;
    padding: 1.5rem 0 1rem;
  }
  @media (max-width: 859px) { .graph-hero { height: auto; min-height: 0; padding: 1.5rem 0 2.5rem; } }
  .starfield {
    position: absolute; inset: 0;
    background-image:
      radial-gradient(1.5px 1.5px at 10% 15%, #ffffff88, transparent),
      radial-gradient(1.5px 1.5px at 80% 10%, #ffffff66, transparent),
      radial-gradient(1px 1px at 45% 30%, #ffffff55, transparent),
      radial-gradient(1.5px 1.5px at 65% 55%, #ffffff44, transparent),
      radial-gradient(1px 1px at 25% 70%, #ffffff55, transparent),
      radial-gradient(1.5px 1.5px at 90% 65%, #ffffff44, transparent),
      radial-gradient(1px 1px at 15% 85%, #ffffff33, transparent),
      radial-gradient(1.5px 1.5px at 55% 90%, #ffffff33, transparent);
    background-size: 100% 100%;
    opacity: .8;
  }
  .moon { position: absolute; top: 6%; right: 6%; z-index: 1; display: block; width: clamp(28px, 4vw, 44px); opacity: .8; filter: drop-shadow(0 0 8px #ffffff33); }
  .moon :global(svg) { display: block; width: 100%; height: auto; }

  .eyebrow {
    position: relative; z-index: 2;
    margin: 0; padding: 2.75rem 1.25rem 0;
    text-align: center;
    font-family: 'VT323', ui-monospace, monospace;
    font-size: 1.1rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: #5eead4;
  }

  .graph-stage {
    position: relative;
    z-index: 2;
    display: none;
    flex: 0 1 auto;
    height: min(54vh, 600px);
    width: auto;
    max-width: 94vw;
    aspect-ratio: 16 / 9.4;
    margin: .75rem auto 0;
  }
  @media (min-width: 860px) { .graph-stage { display: block; } .graph-mobile { display: none; } }

  .graph-lines { position: absolute; inset: 0; width: 100%; height: 100%; }

  .hub {
    position: absolute; transform: translate(-50%, -50%);
    display: flex; flex-direction: column; align-items: center; gap: .3rem;
    padding: .5rem .55rem;
    width: max-content;
    min-width: clamp(72px, 7.5vw, 92px);
    background: #0a1017;
    border: 2px solid var(--hub-color);
    box-shadow: 0 0 0 3px #060a0f, 0 0 14px -2px var(--hub-color);
    text-decoration: none;
    text-align: center;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .hub:hover, .hub:focus-visible { transform: translate(-50%, -50%) scale(1.08); box-shadow: 0 0 0 3px #060a0f, 0 0 22px 0 var(--hub-color); color: #e6edf3; }
  .hub-icon { display: block; width: clamp(18px, 2.1vw, 24px); }
  .hub-icon :global(svg) { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  .hub-label {
    display: block;
    white-space: nowrap;
    font-family: 'VT323', ui-monospace, monospace;
    font-size: clamp(.9rem, 1vw, 1.05rem);
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--hub-color);
  }

  .leaf {
    position: absolute; transform: translate(-50%, -50%);
    white-space: nowrap;
    padding: .3rem .55rem;
    background: #0a1017;
    border: 1px solid var(--hub-color);
    color: #c6d1db;
    font-family: 'VT323', ui-monospace, monospace;
    font-size: clamp(.85rem, .95vw, 1rem);
    letter-spacing: .04em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: .9;
  }
  .leaf:hover, .leaf:focus-visible { color: var(--hub-color); border-color: var(--hub-color); opacity: 1; box-shadow: 0 0 10px -2px var(--hub-color); }

  .graph-mobile { position: relative; z-index: 2; width: min(560px, 92vw); margin: 2rem auto 0; color: #c6d1db; }
  .graph-mobile summary { cursor: pointer; font-family: 'VT323', ui-monospace, monospace; font-size: 1.2rem; letter-spacing: .06em; text-transform: uppercase; color: #5eead4; padding: .75rem 1rem; border: 1px solid #263342; }
  .graph-mobile-grid { display: grid; gap: .75rem; margin-top: .75rem; }
  .mobile-hub { border: 1px solid var(--hub-color); padding: .75rem; }
  .mobile-hub-title { display: flex; align-items: center; gap: .5rem; font-family: 'VT323', ui-monospace, monospace; font-size: 1.15rem; letter-spacing: .06em; text-transform: uppercase; color: var(--hub-color); text-decoration: none; }
  .mobile-hub-title .hub-icon { width: 20px; }
  .mobile-leaf-row { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .6rem; }
  .mobile-leaf { font-family: 'VT323', ui-monospace, monospace; font-size: .95rem; text-transform: uppercase; color: #9ba8b5; border: 1px solid #263342; padding: .2rem .5rem; text-decoration: none; }
  .mobile-leaf:hover { color: var(--hub-color); border-color: var(--hub-color); }

  .beam {
    position: relative; z-index: 1;
    margin: 1.5rem auto 0;
    width: 3px; height: clamp(30px, 5vh, 60px);
    background: linear-gradient(#5eead4, transparent);
    opacity: .5;
  }
  .character-wrap { position: relative; z-index: 2; display: flex; justify-content: center; margin-top: .25rem; flex: 1 1 auto; min-height: 0; align-items: flex-end; padding-bottom: .5rem; }
  .character { display: block; width: clamp(180px, 22vw, 300px); max-height: 100%; }
  .character :global(svg) { display: block; width: 100%; height: auto; image-rendering: pixelated; filter: drop-shadow(0 0 18px #5eead41a); }

  .scroll-hint {
    position: absolute; right: clamp(1rem, 4vw, 3rem); bottom: 1.5rem; z-index: 3;
    display: flex; flex-direction: column; align-items: center; gap: .35rem;
    color: #7f8fa3; text-decoration: none;
    font-family: 'VT323', ui-monospace, monospace; font-size: .8rem; letter-spacing: .2em;
  }
  .scroll-icon { display: block; width: 16px; animation: bob 1.8s ease-in-out infinite; }
  .scroll-icon :global(svg) { display: block; width: 100%; height: auto; }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }
  @media (prefers-reduced-motion: reduce) { .scroll-icon { animation: none; } }
</style>
