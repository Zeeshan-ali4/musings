---
import type { CollectionEntry } from 'astro:content';
import { formatDate, postSlug, slugify } from '../lib/site';
import { categoryFor } from '../lib/categories';
interface Props { post: CollectionEntry<'blog'>; index?: number }
const { post, index = 0 } = Astro.props;
const category = categoryFor(post.data.tags);
---
<article class="tile" data-reveal style={`--accent: var(--node-${category}); transition-delay: ${index * 80}ms`}>
  <p class="tile-date">{formatDate(post.data.published)}</p>
  <h3 class="tile-title"><a href={`/blog/${postSlug(post.id)}/`}>{post.data.title}</a></h3>
  <p class="tile-desc">{post.data.description}</p>
  <div class="tile-tags">{post.data.tags.map((tag) => <a href={`/tags/${slugify(tag)}/`}>#{tag}</a>)}</div>
</article>

<style>
  .tile {
    position: relative;
    border: 1px solid #263342;
    border-top: 3px solid var(--accent);
    background: #111922;
    padding: 1.5rem;
    transition: border-color .5s ease, transform .5s ease, opacity .5s ease, box-shadow .2s ease;
  }
  .tile:hover { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 0 18px -6px var(--accent); }
  .tile-date { margin: 0; font-family: 'VT323', ui-monospace, monospace; font-size: 1.05rem; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  .tile-title { margin: .6rem 0 0; font-size: 1.25rem; font-weight: 600; color: #e6edf3; }
  .tile-title a { text-decoration: none; }
  .tile-desc { margin: .65rem 0 0; color: #9ba8b5; line-height: 1.6; }
  .tile-tags { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.1rem; }
  .tile-tags a { border: 1px solid #263342; padding: .2rem .5rem; font-family: 'VT323', ui-monospace, monospace; font-size: 1rem; color: #9ba8b5; text-decoration: none; }
  .tile-tags a:hover { border-color: var(--accent); color: var(--accent); }
</style>