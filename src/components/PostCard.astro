---
import type { CollectionEntry } from 'astro:content';
import { formatDate, postSlug, slugify } from '../lib/site';
const { post } = Astro.props as { post: CollectionEntry<'blog'> };
---
<article class="post-card"><p class="font-mono text-xs tracking-wider text-signal">{formatDate(post.data.published)} <span aria-hidden="true">·</span> My notebook</p><h2 class="mt-3 text-2xl font-semibold text-ink"><a class="no-underline" href={`/blog/${postSlug(post.id)}/`}>{post.data.title}</a></h2><p class="mt-3 leading-7 text-slate">{post.data.description}</p><div class="mt-5 flex flex-wrap gap-2">{post.data.tags.map((tag) => <a href={`/tags/${slugify(tag)}/`} class="note-tag no-underline">#{tag}</a>)}</div></article>
