---
import { SITE } from '../lib/site';
const path = Astro.url.pathname;
const nav = [['/blog', 'Research'], ['/about', 'About'], ['/security', 'Security']];
---
<header class="border-b border-line bg-[#0a1017]/95">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-5">
    <a href="/" class="font-mono text-sm font-bold tracking-[.16em] text-ink no-underline">{SITE.name.toUpperCase()}</a>
    <nav aria-label="Main navigation" class="flex gap-4 text-sm text-slate sm:gap-6">
      {nav.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
</header>
<script is:inline>
  (function () {
    var header = document.querySelector('header');
    var setH = function () { document.documentElement.style.setProperty('--header-h', header.offsetHeight + 'px'); };
    setH();
    window.addEventListener('resize', setH);
  })();
</script>