---
// Renders a small ASCII bitmap ("#" = filled, " " = empty) as crisp SVG pixels.
// Each row is a string of equal length; one <rect> per filled cell.
interface Props { map: string[]; color: string; class?: string }
const { map, color, class: klass = '' } = Astro.props;
const cols = Math.max(...map.map((r) => r.length));
const rows = map.length;
---
<svg viewBox={`0 0 ${cols} ${rows}`} class={klass} shape-rendering="crispEdges" aria-hidden="true" focusable="false">
  {map.map((row, y) => [...row].map((ch, x) => ch !== ' ' && <rect x={x} y={y} width="1" height="1" fill={color} />))}
</svg>