---
// Hand-built pixel sprite: author at a desk, monitor glowing, plant to the side.
// Drawn with rectangle helpers onto a grid rather than raw ASCII rows -
// far less error-prone to place/adjust than hand-typed bitmap strings.
interface Props { class?: string }
const { class: klass = '' } = Astro.props;

const W = 48;
const H = 32;
type Cell = string | null;
const grid: Cell[][] = Array.from({ length: H }, () => Array.from({ length: W }, () => null));

const rect = (x0: number, y0: number, x1: number, y1: number, c: string) => {
  for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) if (y >= 0 && y < H && x >= 0 && x < W) grid[y][x] = c;
};
const px = (x: number, y: number, c: string) => { if (y >= 0 && y < H && x >= 0 && x < W) grid[y][x] = c; };

const C = {
  wood: '#8a5a34', woodDark: '#6b4423',
  chair: '#3a4552', chairDark: '#2a323d',
  hair: '#4a3222', skin: '#e2a878',
  hoodie: '#3b6bd6', hoodieDark: '#2c52ab', hoodieLight: '#5a86e8',
  denim: '#20293a', shoe: '#e7ecf1',
  monitor: '#232c36', monitorEdge: '#141a21',
  screen: '#5eead4', screenDim: '#1c4d47',
  keyboard: '#1a222c', key: '#3a4552',
  pot: '#7a4a2a', leaf: '#4ee08a', leafDark: '#2f9e63'
};

// chair (drawn first so the body layers over it)
rect(6, 9, 16, 13, C.chairDark);
rect(6, 13, 17, 24, C.chair);

// legs hinted under the desk
rect(11, 20, 23, 23, C.denim);

// torso / hoodie
rect(9, 15, 25, 22, C.hoodie);
rect(9, 15, 25, 16, C.hoodieLight);
rect(9, 21, 25, 22, C.hoodieDark);
// arms reaching to keyboard
rect(8, 18, 13, 21, C.hoodie);
rect(21, 18, 26, 21, C.hoodie);
rect(8, 20, 13, 21, C.hoodieDark);
rect(21, 20, 26, 21, C.hoodieDark);

// neck + head
rect(15, 12, 19, 14, C.skin);
rect(13, 7, 21, 13, C.skin);
// hair
rect(12, 5, 22, 8, C.hair);
rect(12, 8, 14, 12, C.hair);
rect(20, 8, 22, 12, C.hair);

// desk
rect(1, 23, 46, 24, C.wood);
rect(1, 24, 46, 25, C.woodDark);
rect(4, 26, 6, 31, C.woodDark);
rect(38, 26, 40, 31, C.woodDark);

// keyboard
rect(12, 21, 24, 22, C.keyboard);
px(14, 21, C.key); px(17, 21, C.key); px(20, 21, C.key); px(23, 21, C.key);

// monitor
rect(27, 9, 41, 20, C.monitorEdge);
rect(28, 10, 40, 19, C.monitor);
rect(29, 11, 39, 18, C.screenDim);
rect(30, 12, 38, 17, C.screen);
rect(33, 20, 35, 22, C.monitor);
rect(29, 22, 39, 23, C.monitor);

// plant
rect(42, 19, 45, 23, C.pot);
rect(41, 17, 46, 19, C.leafDark);
rect(42, 13, 45, 17, C.leaf);
px(43, 11, C.leaf); px(44, 15, C.leaf); px(40, 15, C.leafDark);
---
<svg viewBox={`0 0 ${W} ${H}`} class={klass} shape-rendering="crispEdges" aria-hidden="true" focusable="false">
  {grid.map((row, y) => row.map((c, x) => c && <rect x={x} y={y} width="1" height="1" fill={c} />))}
</svg>