---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { formatDate, slugify } from '../lib/site';
const { post, headings } = Astro.props as { post: CollectionEntry<'blog'>; headings: { depth: number; slug: string; text: string }[] };
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-6xl px-5 py-14 lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-14">
    <div class="min-w-0"><a class="font-mono text-xs uppercase tracking-wider text-signal" href="/blog/">← All writing</a><header class="mt-7 border-b border-line pb-9"><p class="font-mono text-xs uppercase tracking-wider text-signal">{formatDate(post.data.published)}{post.data.updated && ` · Updated ${formatDate(post.data.updated)}`}</p><p class="mt-4 text-sm text-slate">By Zeeshan · working note</p><h1 class="mt-3 max-w-4xl text-4xl font-semibold tracking-tight text-ink sm:text-5xl">{post.data.title}</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-slate">{post.data.description}</p><div class="mt-6 flex flex-wrap gap-3">{post.data.tags.map((tag) => <a href={`/tags/${slugify(tag)}/`} class="note-tag no-underline">#{tag}</a>)}</div></header><div class="article-preface">A model to work from, not the last word. If there is a missing caveat or a clearer framing, this note should change.</div><div class="prose max-w-3xl"><slot /></div><nav class="mt-12 border-t border-line pt-6"><a href="/blog/">← Back to the notebook</a></nav></div>
    {headings.length > 1 && <aside class="mt-10 lg:mt-1"><nav aria-label="Table of contents" class="border-l border-line pl-4"><p class="font-mono text-xs uppercase tracking-wider text-slate">On this page</p><ol class="mt-3 space-y-2 text-sm text-slate">{headings.filter((h) => h.depth <= 3).map((h) => <li class={h.depth === 3 ? 'pl-3' : ''}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></aside>}
  </article>
</BaseLayout>
